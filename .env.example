# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Gateway (S2) ─────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me

# ── MongoDB ──────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local docker-compose: mongodb://mongo:27017/riskreport
MONGODB_URI=

# ── Service URLs ─────────────────────────────────────────────────────────
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles
# ── Shared ──────────────────────────────────────────────────────────────
# One file, both run modes. Values here are the manual/local-run defaults
# (localhost URLs); docker-compose.yml overrides the three *_SERVICE_URL
# vars below to Docker service names for the `server` container only — see
# CLAUDE.md "Known pitfalls" for why. Don't edit those three for Docker use;
# just run `docker-compose up` and the override applies automatically.

MONGODB_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@REPLACE_ME.mongodb.net/a2603   # Atlas connection string — replace with your own (or use mongodb://mongo:27017/a2603 for the local Docker Mongo container instead)
AWS_REGION=ap-southeast-1                        # S3 and Textract region
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET_NAME=a2603-documents

# ── Server (S2) ──────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=REPLACE_ME                            # min 32 chars in prod
INGESTION_SERVICE_URL=http://localhost:8001      # docker-compose.yml overrides this to http://ingestion-service:8001 in containers
RAG_SERVICE_URL=http://localhost:8002            # docker-compose.yml overrides this to http://rag-service:8002 in containers
SPEECH_OCR_SERVICE_URL=http://localhost:8003     # docker-compose.yml overrides this to http://speech-ocr-service:8003 in containers

# ── RAG service (S4) ─────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                           # or "gemini" — swappable
ANTHROPIC_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME                        # only needed if provider=gemini
EMBEDDING_MODEL=voyage-large-2                   # or text-embedding-3-large

# ── Speech / OCR service (S5) ────────────────────────────────────────────
WHISPER_MODEL=whisper-1                          # OpenAI Whisper API model
OPENAI_API_KEY=REPLACE_ME                        # for Whisper STT
USE_CLOUD_OCR=false                              # true = AWS Textract, false = Tesseract
