# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Gateway (S2) ─────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me

# ── MongoDB ──────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local docker-compose: mongodb://mongo:27017/riskreport
MONGODB_URI=

# ── Service URLs ─────────────────────────────────────────────────────────
INGESTION_SERVICE_URL=http://ingestion-service:8001
RAG_SERVICE_URL=http://rag-service:8002
SPEECH_OCR_SERVICE_URL=http://speech-ocr-service:8003

# ── AWS S3 ───────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=is4108-marshriskreport-rawfiles
